{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 920,
        "minHeight": 600,
        "minWidth": 640,
        "title": "SignCraft",
        "width": 800
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev -- --port 5174",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "windowSize": {
          "height": 380,
          "width": 540
        }
      }
    },
    "targets": [
      "dmg",
      "nsis"
    ]
  },
  "identifier": "com.longyunbegin.signcraft",
  "productName": "SignCraft",
  "version": "1.0.0"
}